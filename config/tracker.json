{
  "schema_version": "0.1-draft",
  "repository": "psiQAQ/agent-memory-github-trending",
  "approval_state": "pending",
  "automation_enabled": false,
  "implementation_ready": false,
  "proposed_defaults": {
    "interval_hours": 12,
    "schedule_anchor": "on_activation",
    "storage_timezone": "UTC",
    "report_timezone": "Asia/Shanghai",
    "language": "zh-CN",
    "scope": "engineering_plus_research_code_and_benchmarks",
    "priority": "balanced_with_coding_agent_view",
    "main_ranking_requires_public_implementation": true,
    "initial_tracked_target": 20,
    "max_tracked_and_watchlist": 50,
    "watchlist_interval_hours": 72,
    "max_new_candidate_reviews_per_run": 10,
    "max_deep_change_reviews_per_run": 5,
    "candidate_min_stars": 0,
    "ranking_windows_days": [7, 30],
    "baseline_tolerance_hours": 6,
    "attention_flags": {
      "min_net_stars_24h": 100,
      "min_net_stars_7d_for_relative_flag": 100,
      "min_relative_growth_7d": 0.2
    },
    "publish_policy": "direct_main_for_approved_data_and_reports",
    "notify": "material_changes_actionable_failures_weekly_and_first_scheduled_verification",
    "weekly_policy": "summarize_each_closed_iso_week_on_next_successful_check",
    "readme_max_lines": 250,
    "allow_paid_apis": false,
    "allow_upstream_code_execution": false,
    "allow_force_push": false,
    "allow_policy_self_modification": false,
    "snapshot_retention": "preserve_time_partitioned_history",
    "secondary_scheduler": "not_configured"
  }
}
